{
  "name": "echo smoke test",
  "description": "Generated by hand for the demo echo server — covers the happy path, chaining, latency, and errors.",
  "steps": [
    {
      "as": "greeting",
      "call": "upper",
      "args": { "text": "hello" },
      "expect": {
        "ok": true,
        "equals": { "result.content.0.text": "HELLO" }
      },
      "extract": { "shout": "result.content.0.text" }
    },
    {
      "call": "echo",
      "args": { "text": "{{vars.shout}}!" },
      "expect": {
        "ok": true,
        "equals": { "result.content.0.text": "Echo: HELLO!" }
      }
    },
    {
      "call": "add",
      "args": { "a": 1, "b": 2 },
      "expect": {
        "ok": true,
        "equals": { "result.content.0.text": "3" },
        "latencyMs": { "max": 2000 }
      }
    },
    {
      "call": "slow",
      "args": { "ms": 120 },
      "expect": {
        "ok": true,
        "contains": { "result.content.0.text": "slept 120" },
        "latencyMs": { "max": 5000 }
      }
    },
    {
      "call": "fail",
      "args": { "message": "intentional demo failure" },
      "expect": {
        "ok": false,
        "errorContains": "intentional"
      }
    },
    {
      "call": "totals",
      "args": { "items": [ { "name": "coffee", "price": 3.5 }, { "name": "tea", "price": 2.0 } ] },
      "expect": {
        "ok": true,
        "equals": { "result.structuredContent.count": 2, "result.structuredContent.total": 5.5 }
      }
    }
  ]
}
